# Copy to `.env` (gitignored) and fill in. Every variable the framework reads
# is listed here. Precedence: shell / CI variables > `.env.<TEST_ENV>` > `.env`.
# Never put a credential value in this file or in `.env` that is committed.

# --- Environment ------------------------------------------------------------
# local | dev | staging | qa | prod   (migration work runs on staging)
TEST_ENV=staging
# Overrides baseURL / apiURL for `local` and `dev` only (staging/qa ignore it).
BASE_URL=
API_URL=
# Port of the local fixture API used by the `local` environment.
FIXTURE_API_PORT=4010
# Command to start the app under test before the run (optional).
WEB_SERVER_COMMAND=

# --- Credentials ------------------------------------------------------------
# Absolute path to your credentials file, kept OUTSIDE this repository
# (.json flat key/value, or Java .properties as used by the Selenium suite).
CREDENTIALS_FILE=
# Legacy alias, used only when CREDENTIALS_FILE is empty.
CREDS_FILE_PATH=
# A key from the credentials file (e.g. KSP_Password) may also be set here
# directly; an env var with the key's exact name wins over the file.

# `dev` and `prod` environments read these directly.
DEV_USER=
DEV_PASSWORD=
DEV_ADMIN_USER=
DEV_ADMIN_PASSWORD=
PROD_SMOKE_USER=
PROD_SMOKE_PASSWORD=

# --- Healing and AI -----------------------------------------------------------
# off for migration verification runs (playbook rule); on to let the healer repair.
AI_HEAL=off
AI_HEAL_PERSIST=off
AI_HEAL_STRICT=
AI_HEAL_CACHE=
AI_HEAL_MIN_CONFIDENCE=
AI_HEAL_MIN_SCORE=
AI_HEAL_MAX_PER_RUN=
AI_ANALYSIS=
AI_MODEL=
AI_FAST_MODEL=
AI_EFFORT=
AI_LOCATORS_DIR=
AI_TEST_ID_ATTRIBUTE=
# debug | info | warn | error
AI_LOG_LEVEL=info
ANTHROPIC_API_KEY=

# --- Migration ----------------------------------------------------------------
# Local checkout of the Selenium repository to migrate from (read-only). Used by
# `aiqa migrate` and `npm run migrate:drafts` unless --input is passed.
# Machine-specific: set it only in your own .env, never commit a real path.
SELENIUM_PROJECT_PATH= D:\Keysight_Automation_Project\ksp-test-automation\ksp-test-automation

# --- Run ----------------------------------------------------------------------
# Fixed run id for test-owned data (normally generated per run).
AIQA_RUN_ID=
